# Forcer le HTTPS
RewriteEngine On
RewriteCond %{SERVER_PORT} 80
# RewriteRule ^(.*)$ https://knowitbetter.fr/$1 [R,L]

# Enlever le .php des fichiers
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^\.]+)$ $1.php [NC,L]


# pages personalisees
ErrorDocument 404 /error/404.php
ErrorDocument 400 /error/400.php
ErrorDocument 403 /error/403.php
ErrorDocument 500 /error/500.php

# Empecher acces a la hierarchie des dossiers
Options -Indexes

# redirections permanentes
Redirect 301 /compte.php /account.php
Redirect 301 /compte /account

# cache pour les images de 3 jours
 <IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|ico|svg|webp)$">
        Header set Cache-Control "max-age=259200, public"
    </FilesMatch>
</IfModule>

# Redirection de www vers non-www
RewriteCond %{HTTP_HOST} ^www\.knowitbetter\.fr [NC]
# RewriteRule ^(.*)$ https://knowitbetter.fr/$1 [L,R=301]
